[Unit]
Description=Snackbar game site
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=snackbar
Group=snackbar
WorkingDirectory=/opt/snackbar
EnvironmentFile=/etc/snackbar.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning --max-old-space-size=4096 server/index.js
Restart=always
RestartSec=3

# Lock it down: the app can only write to its data folder.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/snackbar
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
CapabilityBoundingSet=
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
